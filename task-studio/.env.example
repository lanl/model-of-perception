# Optional deployment overrides. Render sets its public URL automatically.
# These are examples; the app reads environment variables, not this file.
# PUBLIC_BASE_URL=https://tasks.example.org
# ALLOWED_HOSTS=tasks.example.org
# SECRET_KEY=replace-with-a-random-secret
PORT=8765
MAX_TASKS=50
SESSION_TTL_SECONDS=3600
JOB_TTL_SECONDS=3600
MAX_JOB_SECONDS=300
MAX_STORAGE_BYTES=536870912
OUTPUT_DIR=runs
